{
	"name": "InfothequeCore",
	"version": "0.1.0",
	"author": [
		"Lewis Bedar"
	],
	"descriptionmsg": "infothequecore-desc",
	"license-name": "MIT",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"manifest_version": 2,
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\InfothequeCore\\": "src/"
	},
	"SpecialPages": {
		"InfothequeCore": {
			"class": "MediaWiki\\Extension\\InfothequeCore\\SpecialInfothequeCore"
		},
		"InfothequeCoreOptions": {
			"class": "MediaWiki\\Extension\\InfothequeCore\\Special\\SpecialInfothequeCoreOptions"
		}
	},
	"AvailableRights": [
		"ithc-manage-options"
	],
	"GroupPermissions": {
		"sysop": {
			"ithc-manage-options": true
		}
	},
	"MessagesDirs": {
		"InfothequeCore": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.infothequeCore.special": {
			"localBasePath": "resources",
			"remoteExtPath": "InfothequeCore/resources",
			"scripts": [
				"ext.infothequeCore.special.js"
			],
			"styles": [
				"ext.infothequeCore.special.css"
			],
			"dependencies": [
				"oojs-ui-core",
				"oojs-ui-widgets"
			]
		},
		"ext.infothequeCore.editorButton": {
			"localBasePath": "resources",
			"remoteExtPath": "InfothequeCore/resources",
			"scripts": [
				"ext.infothequeCore.editorButton.js"
			],
			"styles": [
				"ext.infothequeCore.editorButton.css"
			],
			"messages": [
				"infothequecore-editor-trigger",
				"infothequecore-add-row",
				"infothequecore-remove-row",
				"infothequecore-loading-existing",
				"infothequecore-insert-button",
				"infothequecore-cancel-button",
				"infothequecore-edit-row",
				"infothequecore-move-row-up",
				"infothequecore-move-row-down",
				"infothequecore-links-add",
				"infothequecore-links-url-placeholder",
				"infothequecore-links-label-placeholder",
				"infothequecore-links-remove",
				"infothequecore-photo-browse-placeholder",
				"infothequecore-select-placeholder",
				"infothequecore-schema-mismatch-warning",
				"infothequecore-file-upload-button",
				"infothequecore-multifile-add"
			],
			"dependencies": [
				"mediawiki.util",
				"mediawiki.api"
			]
		}
	},
	"APIModules": {
		"infothequecore": "MediaWiki\\Extension\\InfothequeCore\\Api\\ApiInfothequeCore"
	},
	"Hooks": {
		"EditPage::showEditForm:initial": "MediaWiki\\Extension\\InfothequeCore\\Hooks::onEditPageShowEditFormInitial",
		"LoadExtensionSchemaUpdates": "MediaWiki\\Extension\\InfothequeCore\\Hooks::onLoadExtensionSchemaUpdates"
	}
}
